# Goldenhub RealtyOS production environment example
# Copy to /opt/goldenhub/realtyos/.env.production and replace every CHANGE_ME value.

NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

NEXT_PUBLIC_APP_URL=https://app.goldenhub.co.uk
NEXT_PUBLIC_PLATFORM_APP_PATH=/realtyos
NEXT_PUBLIC_PRODUCT_NAME=Goldenhub RealtyOS
NEXT_PUBLIC_DEFAULT_COMPANY_NAME=Goldenhub Investments Ltd
NEXT_PUBLIC_DEFAULT_SITE_TAGLINE=Supported accommodation services
NEXT_PUBLIC_DEFAULT_CONTACT_EMAIL=info@goldenhub.co.uk
NEXT_PUBLIC_DEFAULT_OWNER_EMAIL=admin@goldenhub.co.uk
NEXT_PUBLIC_DEFAULT_LOGO_PATH=/goldenhub-logo.svg
NEXT_PUBLIC_DEFAULT_PLATFORM_LOGO_PATH=/goldenhub-mark.svg
NEXT_PUBLIC_DEFAULT_PRIMARY_COLOR=#090909
NEXT_PUBLIC_DEFAULT_SECONDARY_COLOR=#d4af37
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#b99024
NEXT_PUBLIC_DEFAULT_LOCALE=en-GB
NEXT_PUBLIC_DEFAULT_TIMEZONE=Europe/London
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP
NEXT_PUBLIC_SEO_TITLE=Goldenhub Investments Ltd | Goldenhub RealtyOS

PUBLIC_WEBSITE_AGENCY=Goldenhub Investments Ltd
REALTYOS_ADMIN_EMAIL=admin@goldenhub.co.uk

# Generate using: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
SESSION_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Local PostgreSQL example
DATABASE_URL=postgresql://realtyos:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:5432/realtyos

# Persistent storage prepared by ops/oci/bootstrap-almalinux.sh
DOCUMENT_STORAGE_ROOT=/mnt/storage/goldenhub

# Optional SMTP settings for future notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Goldenhub RealtyOS <info@goldenhub.co.uk>
