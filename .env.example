# Runtime
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_APP_PATH=/realtyos
NEXT_PUBLIC_BASE_PATH=
AUTH_SECRET=replace_with_a_long_random_secret_32_chars_minimum
AUTH_COOKIE_SECURE=false
DATABASE_URL=postgres://platform:change_me@postgres:5432/platform
DATABASE_SSL=false

# White-label defaults used before database-backed admin settings are completed
NEXT_PUBLIC_PRODUCT_NAME="Supported Housing Platform"
NEXT_PUBLIC_DEFAULT_COMPANY_NAME="Your Housing Organisation"
NEXT_PUBLIC_DEFAULT_SITE_TAGLINE="Supported accommodation services"
NEXT_PUBLIC_DEFAULT_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_DEFAULT_OWNER_EMAIL=admin@platform.local
NEXT_PUBLIC_DEFAULT_LOGO_PATH=/RealtyOSLogo.svg
NEXT_PUBLIC_DEFAULT_PLATFORM_LOGO_PATH=/RealtyOSLogo.svg
NEXT_PUBLIC_DEFAULT_PRIMARY_COLOR=#172033
NEXT_PUBLIC_DEFAULT_SECONDARY_COLOR=#f4c542
NEXT_PUBLIC_DEFAULT_ACCENT_COLOR=#b99024
NEXT_PUBLIC_DEFAULT_LOCALE=en-GB
NEXT_PUBLIC_DEFAULT_TIMEZONE=Europe/London
NEXT_PUBLIC_DEFAULT_CURRENCY=GBP
NEXT_PUBLIC_SEO_TITLE="Your Housing Organisation | Supported Housing Platform"

# First-run/bootstrap values
REALTYOS_AGENCY_NAME="Your Housing Organisation"
REALTYOS_AGENCY_EMAIL=admin@example.com
REALTYOS_AGENCY_PHONE=
REALTYOS_AGENCY_REGISTRATION=
REALTYOS_AGENCY_LOCAL_AUTHORITY=
REALTYOS_ADMIN_NAME="Platform Administrator"
REALTYOS_ADMIN_EMAIL=admin@platform.local
REALTYOS_ADMIN_PASSWORD=replace_with_a_strong_temporary_password
OWNER_ADMIN_EMAILS=admin@platform.local

# File storage
DOCUMENT_STORAGE_ROOT=/mnt/storage
REALTYOS_SHARED_FILE_ROOT=/mnt/storage

# Optional integrations. Leave blank unless configured for a client.
ALLOWED_ORIGINS=http://localhost:3000
EMAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ANALYTICS_ID=
PAYMENT_PROVIDER=
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# Local PostgreSQL/Docker helpers
REALTYOS_PG_CONTAINER=platform-postgres
REALTYOS_PG_DATABASE=platform
REALTYOS_PG_USER=platform
REALTYOS_PG_PASSWORD=change_me
REALTYOS_PG_PORT=5432
